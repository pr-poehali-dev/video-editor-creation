{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "List without auth",
      "method": "GET",
      "path": "/?route=%2Flist",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Upload without auth",
      "method": "POST",
      "path": "/?route=%2Fupload",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Proxy without auth",
      "method": "GET",
      "path": "/?route=%2Fproxy&id=1",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Chunked init without auth",
      "method": "POST",
      "path": "/?route=%2Fchunked%2Finit",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Chunked part without auth",
      "method": "POST",
      "path": "/?route=%2Fchunked%2Fpart",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Chunked complete without auth",
      "method": "POST",
